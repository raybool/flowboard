  "type": "module",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:test:check": "node ./scripts/test-database.mjs check",
    "db:test:create": "node ./scripts/test-database.mjs create",
    "db:test:status": "node ./scripts/test-database.mjs status",
    "test:database-helper": "node --test ./scripts/test-database.test.mjs",
    "db:deploy": "node ./scripts/test-database.mjs migrate",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "labels:report-name-key-collisions": "node --experimental-strip-types ./scripts/report-label-name-key-collisions.ts",
    "labels:backfill-name-keys": "node --experimental-strip-types ./scripts/backfill-label-name-keys.ts",
    "dev": "nest start --watch",
    "prebuild": "pnpm db:generate",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:postgres": "node ./scripts/test-database.mjs test",
    "test:postgres:http": "node ./scripts/test-database.mjs test-http",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
