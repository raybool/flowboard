// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String?
  passwordHash String    @map("password_hash")

  sessions     Session[]
  workspaceMemberships WorkspaceMember[]
  createdTasks  Task[]
  taskCommentAuthors TaskComment[] @relation("TaskCommentAuthor")
  taskCommentDeletions TaskComment[] @relation("TaskCommentDeletedBy")
  taskActivities TaskActivity[]

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")

  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedRefreshTokens UsedRefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model UsedRefreshToken {
  tokenHash String @id @map("token_hash")
  sessionId String @map("session_id")
  usedAt DateTime @default(now()) @map("used_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("used_refresh_tokens")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique

  members   WorkspaceMember[]
  projects  Project[]
  tasks     Task[]
  labels    Label[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)

  workspace Workspace @relation( fields: [workspaceId], references: [id], onDelete: Cascade )

  user User @relation( fields: [userId], references: [id], onDelete: Cascade )
  assignedTasks Task[]

  joinedAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@unique([workspaceId, id])
  @@index([userId])
  @@map("workspace_members")
}

model Project {
  id               String    @id @default(uuid())
  workspaceId      String
  name             String
  key              String
  description      String?
  nextTaskSequence Int       @default(1)
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([workspaceId, key])
  @@unique([workspaceId, id])
  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
  @@map("projects")
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id               String       @id @default(uuid())
  workspaceId      String
  projectId        String
  sequence         Int
  title            String
  description      String?
  status           TaskStatus   @default(BACKLOG)
  priority         TaskPriority @default(NONE)
  creatorId        String
  assigneeMemberId String?
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  creator       User           @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  assigneeMember WorkspaceMember? @relation(fields: [workspaceId, assigneeMemberId], references: [workspaceId, id], onDelete: Restrict)
  comments      TaskComment[]
  labels        TaskLabel[]
  activities    TaskActivity[]

  @@unique([workspaceId, id])
  @@unique([projectId, sequence])
  @@index([workspaceId])
  @@index([workspaceId, projectId])
  @@index([projectId, status])
  @@index([workspaceId, status])
  @@index([assigneeMemberId])
  @@index([workspaceId, assigneeMemberId])
  @@index([projectId, createdAt, id])
  @@index([workspaceId, createdAt, id])
  @@map("tasks")
}

enum TaskActivityType {
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_PRIORITY_CHANGED
  TASK_ASSIGNEE_CHANGED
  TASK_ARCHIVED
  COMMENT_CREATED
  COMMENT_UPDATED
  COMMENT_DELETED
  LABEL_ADDED
  LABEL_REMOVED
}

model TaskComment {
  id                String    @id @default(uuid())
  workspaceId       String    @map("workspace_id")
  taskId            String    @map("task_id")
  authorId          String?   @map("author_id")
  authorDisplayName String    @map("author_display_name")
  content           String?
  deletedAt         DateTime? @map("deleted_at")
  deletedById       String?   @map("deleted_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  task      Task  @relation(fields: [workspaceId, taskId], references: [workspaceId, id], onDelete: Cascade)
  author    User? @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  deletedBy User? @relation("TaskCommentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, taskId, createdAt, id])
  @@index([workspaceId, authorId, createdAt, id])
  @@map("task_comments")
}

model Label {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  nameKey     String   @map("name_key")
  color       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, nameKey])
  @@index([workspaceId, createdAt, id])
  @@map("labels")
}

model TaskLabel {
  workspaceId String @map("workspace_id")
  taskId      String @map("task_id")
  labelId     String @map("label_id")

  task  Task  @relation(fields: [workspaceId, taskId], references: [workspaceId, id], onDelete: Cascade)
  label Label @relation(fields: [workspaceId, labelId], references: [workspaceId, id], onDelete: Cascade)

  @@id([workspaceId, taskId, labelId])
  @@index([workspaceId, labelId, taskId])
  @@index([workspaceId, taskId, labelId])
  @@map("task_labels")
}

model TaskActivity {
  id               String           @id @default(uuid())
  workspaceId      String           @map("workspace_id")
  taskId           String           @map("task_id")
  actorId          String?          @map("actor_id")
  actorDisplayName  String?         @map("actor_display_name")
  type             TaskActivityType
  eventVersion     Int              @default(1) @map("event_version")
  payload          Json
  correlationId    String?          @map("correlation_id")
  requestId        String?          @map("request_id")
  createdAt        DateTime         @default(now()) @map("created_at")

  task  Task  @relation(fields: [workspaceId, taskId], references: [workspaceId, id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, taskId, createdAt, id])
  @@index([workspaceId, actorId, createdAt, id])
  @@map("task_activities")
}
